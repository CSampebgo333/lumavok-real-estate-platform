PORT=4000
NODE_ENV=development
# API runtime connection: restricted non-owner login, supplied privately.
DATABASE_URL=
# Migration processes use DIRECT_URL separately; the API runtime does not receive it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Privileged Storage credential: server-only and separate from the SQL login.
SUPABASE_STORAGE_KEY=
AUTH_REDIRECT_URL=http://localhost:3000/reset-password
AUTH_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
CORS_ORIGIN=http://localhost:3000
CONTENT_READ_MODE=localized
# Operators verify the proxy chain and block bypass ingress before changing this value.
TRUST_PROXY_HOPS=0
